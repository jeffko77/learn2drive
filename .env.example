# Neon pooled connection used by Prisma Client at runtime.
# Copy the connection string labeled "pooled" in the Neon console
# (hostname contains `-pooler`).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon direct (unpooled) connection used by Prisma Migrate.
# Same credentials as DATABASE_URL with `-pooler` removed from the hostname.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"
